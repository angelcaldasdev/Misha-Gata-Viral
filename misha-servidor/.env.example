# ============================================
# Copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube a GitHub; este .env.example sí (no tiene secretos).
# ============================================

# Secreto para firmar los tokens de sesión (largo y aleatorio).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Usa uno DISTINTO en tu computadora y en la nube.
JWT_SECRETO=

# Base de datos en la nube (Turso). Si los dejas vacíos, se usa el archivo local misha.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Páginas autorizadas a usar la API, separadas por comas y sin "/" al final (opcional).
# Si no lo defines, se permiten GitHub Pages de angelcaldasdev y Live Server local.
# ORIGENES_PERMITIDOS=https://angelcaldasdev.github.io,http://127.0.0.1:5500,http://localhost:5500

